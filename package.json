{
  "name": "rotaja",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch servidor/servidor.js",
    "build": "node rotinas/verificar-sintaxe.js",
    "start": "node servidor/servidor.js",
    "test": "node --test testes/*.test.js",
    "db:gerar": "prisma generate",
    "db:migrar": "prisma migrate dev",
    "db:seed": "node prisma/popular.js",
    "banco:popular": "node prisma/popular.js",
    "test:integracao": "node rotinas/verificar-integracao.js",
    "local": "powershell -ExecutionPolicy Bypass -File rotinas/iniciar-local.ps1",
    "dev:web": "npm --prefix interface run dev",
    "build:web": "npm --prefix interface run build",
    "test:e2e": "npm --prefix interface run test:e2e",
    "desenvolver": "node --watch servidor/servidor.js",
    "verificar": "node rotinas/verificar-sintaxe.js",
    "iniciar": "node servidor/servidor.js",
    "testar": "node --test testes/*.test.js",
    "interface:desenvolver": "npm --prefix interface run dev",
    "interface:compilar": "npm --prefix interface run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "socket.io": "4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "socket.io-client": "^4.8.1"
  }
}
