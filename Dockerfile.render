FROM node:22-bookworm-slim AS interface
WORKDIR /interface
COPY interface/package*.json ./
RUN npm ci
COPY interface ./
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
# Prisma CLI é necessário para as migrações na inicialização do plano gratuito.
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate
COPY servidor ./servidor
COPY rotinas/iniciar-hospedagem.js ./rotinas/iniciar-hospedagem.js
COPY --from=interface /interface/publicacao ./interface/publicacao
ENV NODE_ENV=production SERVIR_INTERFACE=true COOKIE_SEGURO=true PROXY_CONFIAVEL=true
USER node
CMD ["node", "rotinas/iniciar-hospedagem.js"]
